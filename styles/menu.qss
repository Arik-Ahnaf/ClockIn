QMenu { background: #2A2D34; color: #FFFFF3; border: 1px solid #868686;
        padding: 5px; font-family: 'Roboto'; font-size: 14px; }
QMenu::item { padding: 7px 20px; }
QMenu::item:selected { background: #13506C; }
QMenu::item:disabled { color: #868686; }
QMenu::separator { height: 1px; background: #464646; margin: 4px; }
