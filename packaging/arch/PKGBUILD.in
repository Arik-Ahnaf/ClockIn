# Generated by build.py from the local onedir archive and its SHA-256.
pkgname=clockin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Desktop timers with floating controls'
arch=('x86_64')
depends=('glibc' 'gcc-libs' 'fontconfig' 'freetype2' 'libglvnd' 'libx11'
         'libxcb' 'libxext' 'libxrender' 'libxi' 'libxkbcommon' 'libxkbcommon-x11'
         'xcb-util-cursor' 'xcb-util-image' 'xcb-util-keysyms' 'xcb-util-renderutil'
         'xcb-util-wm' 'dbus' 'zlib')
optdepends=('xorg-xwayland: floating window positioning in Wayland sessions')
# Preserve PyInstaller's binaries and its bundled shared-library layout.
options=('!strip' '!debug')
source=('@ARCHIVE@')
sha256sums=('@SHA256@')

package() {
    install -d "$pkgdir/opt/clockin" "$pkgdir/usr/bin"
    cp -a --no-preserve=ownership "$srcdir/ClockIn/." "$pkgdir/opt/clockin/"
    ln -s /opt/clockin/ClockIn "$pkgdir/usr/bin/clockin"
    install -Dm644 "$srcdir/ClockIn/clockin.desktop" "$pkgdir/usr/share/applications/clockin.desktop"
    install -Dm644 "$srcdir/ClockIn/assets/Logo.png" "$pkgdir/usr/share/pixmaps/clockin.png"
}
